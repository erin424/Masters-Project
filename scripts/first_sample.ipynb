    "def load_V_max_values(sample_table):\n",
    "    \"\"\"\n",
    "    Makes a Vmax column in our sample table, loads in the values Duncan calculated.\n",
    "    The survey_id and survey have to match for a galaxy across the tables (as survey_id has degeneracies across surveys).\n",
    "    \"\"\"\n",
    "    sample_survey_id = np.asarray(sample_table[\"#ID\"].data, dtype=int)\n",
    "    sample_surveys = np.asarray(sample_table[\"SURVEY\"].data, dtype=str)\n",
    "\n",
    "    z_bin = [['6.50', '7.50'], ['7.50', '8.50'], ['8.50', '9.50'], ['9.50', '10.50'], ['10.50', '11.50'], ['11.50', '13.50']]\n",
    "    \n",
    "     # Collect the data from all Vmax files\n",
    "    vmax_data = [] # This is a table\n",
    "\n",
    "    for z in z_bin:\n",
    "\n",
    "        path = (f\"{z[0]}<z<{z[1]}_EPOCHS_good_area_depth_scaled_split_region.ecsv\")\n",
    "\n",
    "        data = pd.read_csv(os.path.join(VMAX_PATH, path), delimiter=r\"\\s+\", comment=\"#\")\n",
    "\n",
    "        vmax_data.append(data[[\"ID\", \"survey\", \"Vmax_compl\"]])\n",
    "\n",
    "    vmax_data = pd.concat(vmax_data, ignore_index=True)\n",
    "\n",
    "    # Create a dictionary keyed by (ID, survey), mapped to Vmax_compl, for each row in vmax_data\n",
    "    mapping = {\n",
    "        (int(row.ID), str(row.survey).strip()): float(row.Vmax_compl)\n",
    "        for row in vmax_data.itertuples(index=False)\n",
    "    }\n",
    "    # index=False means the DataFrame's row index is not included in each returned object. This is exclusive to pandas.\n",
    "\n",
    "    # Look up each sample galaxy using BOTH ID and survey\n",
    "    # zip pairs the elements at corresponding positions\n",
    "    # mapping.get acquires the vmax_compl value when the pair is satisifed, but returns np.nan when this fails\n",
    "    vmax_values = np.array( [ mapping.get((int(uid), str(survey).strip()), np.nan) for uid, survey in zip(sample_survey_id, sample_surveys) ], dtype=float)\n",
    "\n",
    "    # Add the results to the sample table\n",
    "    sample_table[\"Vmax\"] = vmax_values\n",
    "\n",
    "    return sample_table"
